{
  "name": "sunbeamart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "node scripts/workers-ci-build.mjs",
    "start": "next start -p ${PORT:-3000}",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply sunbeam-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply sunbeam-db --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9",
    "wrangler": "^4.167.0"
  }
}
